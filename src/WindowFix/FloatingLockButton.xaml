<Window x:Class="WindowFix.FloatingLockButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowFix 고정 버튼" Width="22" Height="56"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Cursor="Hand">
    <!-- Flat sliver glued to the edge; widens into a tab with a padlock on hover / while paused. -->
    <Border x:Name="Tab" CornerRadius="9,0,0,9" Width="6" HorizontalAlignment="Right">
        <Border.Background>
            <SolidColorBrush x:Name="TabFill" Color="#3B5BDB" />
        </Border.Background>
        <Viewbox x:Name="Icon" Width="11" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <Canvas Width="12" Height="16">
                <Path Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M3,7.5 V5 A3,3 0 0 1 9,5 V7.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ShackleShift" X="0" Y="0" />
                    </Path.RenderTransform>
                </Path>
                <Rectangle Canvas.Left="0.5" Canvas.Top="7" Width="11" Height="8.5" RadiusX="2" RadiusY="2" Fill="White" />
                <Ellipse x:Name="Keyhole" Canvas.Left="5" Canvas.Top="10" Width="2" Height="2.6" Fill="#3B5BDB" />
            </Canvas>
        </Viewbox>
    </Border>
</Window>
