<Window x:Class="WindowFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WindowFix.Controls"
        Title="WindowFix — 창 배치 고정" Width="1000" Height="640" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7" FontSize="13">
    <Window.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="#3B5BDB" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StepBody" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB4BF" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B5BDB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2F4AC0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar: what just happened + what to do next -->
        <Border DockPanel.Dock="Bottom" Background="#E8EAEE" Padding="14,6">
            <TextBlock x:Name="StatusText" Foreground="#333" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Lock + settings -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE0E5" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <Border x:Name="LockCard" DockPanel.Dock="Left" CornerRadius="6" Padding="12,8" Margin="0,0,20,0"
                        Background="#EEF1FB" BorderBrush="#C9D2F5" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="LockCheck" Click="OnLockClick" FontSize="15" FontWeight="SemiBold" Margin="0"
                                  ToolTip="켜 두면, 창을 실수로 움직이거나 크기를 바꿔도 저장한 자리로 바로 돌아가요.">
                            <TextBlock x:Name="LockLabel" Text="🔒 창 고정" />
                        </CheckBox>
                        <TextBlock x:Name="LockHint" Style="{StaticResource Hint}" Margin="22,2,0,0" MaxWidth="260"
                                   Text="켜면 창이 저장한 자리에서 움직이지 않아요." />
                    </StackPanel>
                </Border>
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox x:Name="StartupCheck" Content="컴퓨터 켤 때 이 배치로 맞추기" Margin="0,3,22,3" Click="OnStartupClick"
                              ToolTip="컴퓨터를 켜면 WindowFix가 알아서 창들을 이 배치로 맞춰 줘요." />
                    <CheckBox x:Name="ButtonCheck" Content="화면에 고정 버튼 띄우기" Margin="0,3,22,3" Click="OnButtonClick"
                              ToolTip="창 고정 중일 때 화면 구석에 작은 자물쇠 버튼이 떠요. 누르면 잠깐 풀었다가, 다시 누르면 원래 자리로 고정해요." />
                    <CheckBox x:Name="TrayCheck" Content="작업표시줄에 아이콘 표시" Margin="0,3,22,3" Click="OnTrayClick"
                              ToolTip="작업표시줄 오른쪽 아래(시계 옆)에 WindowFix 아이콘을 보여 줘요. 숨겨도 WindowFix를 다시 실행하면 이 창이 열려요." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Saved layouts bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE0E5" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ 지금 배치 저장" Click="OnSaveCurrent" Style="{StaticResource Primary}" Margin="0"
                        ToolTip="지금 화면에 놓인 창들의 위치와 크기를 새 배치로 저장해요." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="저장한 배치" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555" />
                    <ComboBox x:Name="PresetCombo" Width="210" Margin="0,0,8,0" DisplayMemberPath="Name"
                              SelectionChanged="OnPresetSelected" ToolTip="저장해 둔 배치를 골라요." />
                    <Button x:Name="ApplyButton" Content="이 배치로 맞추기" Click="OnApply"
                            ToolTip="고른 배치대로 창들을 지금 바로 옮겨요." />
                    <Button x:Name="RenameButton" Content="이름 바꾸기" Click="OnRename" />
                    <Button x:Name="DeleteButton" Content="삭제" Click="OnDelete" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="#16181C" CornerRadius="6">
                <Grid>
                    <c:MonitorPreview x:Name="Preview" Margin="8,8,8,30" />
                    <TextBlock x:Name="PreviewHint" Foreground="#8A909B" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,8" FontSize="12" Text="창 그림을 누르면 위치나 설정을 고칠 수 있어요." />

                    <!-- First-run guide -->
                    <Border x:Name="Guide" Background="#E616181C" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="처음 오셨나요? 세 단계면 끝나요." Foreground="White" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,0,0,22" HorizontalAlignment="Center" />
                            <DockPanel Margin="0,0,0,18">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StepTitle}" Text="창을 원하는 자리에 놓으세요" />
                                    <TextBlock Style="{StaticResource StepBody}" Text="디스코드, 카톡처럼 늘 켜 두는 창을 평소 쓰는 위치와 크기로 맞춰 두세요." />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,18">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StepTitle}" Text="[+ 지금 배치 저장]을 누르세요" />
                                    <TextBlock Style="{StaticResource StepBody}" Text="떠 있는 창 목록이 나오면, 고정할 창에 체크하고 저장하면 돼요." />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,24">
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StepTitle}" Text="아래 [🔒 창 고정]을 켜세요" />
                                    <TextBlock Style="{StaticResource StepBody}" Text="이제 창을 실수로 건드려도 제자리로 돌아와요. 컴퓨터를 껐다 켜도 유지돼요." />
                                </StackPanel>
                            </DockPanel>
                            <Button Content="+ 지금 배치 저장" Click="OnSaveCurrent" Style="{StaticResource Primary}" HorizontalAlignment="Center"
                                    Padding="20,8" FontSize="14" Margin="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Window settings: shown when a rectangle is clicked -->
            <Border x:Name="EditPanel" Grid.Column="1" Width="280" Margin="12,0,0,0" Background="White" CornerRadius="6"
                    BorderBrush="#DDE0E5" BorderThickness="1" Padding="14,12" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="✕" Click="OnEditClose" Margin="0" Padding="6,0"
                                    Background="Transparent" BorderThickness="0" ToolTip="닫기" />
                            <TextBlock x:Name="EditTitle" Text="창 설정" FontWeight="SemiBold" FontSize="15" />
                        </DockPanel>

                        <TextBlock Text="이름" Foreground="#555" />
                        <TextBox x:Name="NameBox" Margin="0,3,0,10" />

                        <TextBlock Text="위치와 크기" Foreground="#555" />
                        <TextBlock Style="{StaticResource Hint}" Text="모니터 왼쪽 위 모서리에서부터의 거리예요 (픽셀). 보통은 손대지 않아도 돼요." Margin="0,1,0,4" />
                        <UniformGrid Columns="4">
                            <TextBlock Text="가로 위치" Foreground="#888" FontSize="11" />
                            <TextBlock Text="세로 위치" Foreground="#888" FontSize="11" />
                            <TextBlock Text="너비" Foreground="#888" FontSize="11" />
                            <TextBlock Text="높이" Foreground="#888" FontSize="11" />
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="0,2,0,8">
                            <TextBox x:Name="XBox" Margin="0,0,3,0" />
                            <TextBox x:Name="YBox" Margin="0,0,3,0" />
                            <TextBox x:Name="WBox" Margin="0,0,3,0" />
                            <TextBox x:Name="HBox" />
                        </UniformGrid>
                        <CheckBox x:Name="MaxCheck" Content="최대화 상태로 두기" ToolTip="이 창을 모니터를 꽉 채운 상태로 고정해요." />
                        <CheckBox x:Name="LaunchCheck" Margin="0,6,0,0"
                                  ToolTip="배치를 맞출 때 이 프로그램이 꺼져 있으면 켜 주고, 트레이에 숨어 있으면 꺼내서 제자리에 놓아요.">
                            <TextBlock Text="꺼져 있으면 자동으로 켜기 (숨어 있으면 꺼내기)" TextWrapping="Wrap" />
                        </CheckBox>

                        <Expander Header="고급 설정" Margin="0,12,0,0" Foreground="#555">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="제목에 이 글자가 있는 창만" Foreground="#555" />
                                <TextBlock Style="{StaticResource Hint}" Text="같은 프로그램 창이 여러 개일 때 쓰세요. 예: 크롬에서 'YouTube'" />
                                <TextBox x:Name="TitleBox" Margin="0,3,0,8" />
                                <TextBlock Text="실행할 파일" Foreground="#555" />
                                <TextBox x:Name="PathBox" Margin="0,3,0,8" />
                                <TextBlock Text="실행할 때 붙일 옵션" Foreground="#555" />
                                <TextBox x:Name="ArgsBox" Margin="0,3,0,8" />
                                <TextBlock x:Name="MatchInfo" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="저장" Click="OnEntrySave" Style="{StaticResource Primary}" />
                            <Button Content="이 창 빼기" Click="OnEntryRemove" ToolTip="이 창을 배치에서 빼요. 프로그램이 꺼지지는 않아요." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
