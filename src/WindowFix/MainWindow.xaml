<Window x:Class="WindowFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WindowFix.Controls"
        Title="WindowFix" Width="1060" Height="660" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen" FontSize="13" FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Primary}"
        Icon="pack://application:,,,/Assets/WindowFix.ico">
    <Window.Resources>
        <!-- Kept as a resource: event handlers inside a Style setter's ContextMenu crash XAML loading. -->
        <ContextMenu x:Key="LayoutMenu" x:Shared="False">
            <MenuItem Header="이 배치로 맞추기" Click="OnMenuApply" />
            <Separator />
            <MenuItem Header="이름 바꾸기" Click="OnMenuRename" />
            <MenuItem Header="삭제" Click="OnMenuDelete" Style="{StaticResource DangerItem}" />
        </ContextMenu>
        <Style x:Key="LayoutItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnLayoutItemClick" />
            <Setter Property="ContextMenu" Value="{StaticResource LayoutMenu}" />
            <Setter Property="ToolTip" Value="우클릭하면 이름 바꾸기·삭제를 할 수 있어요." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fg.Selected}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <Image Source="pack://application:,,,/Assets/WindowFix.ico" Width="22" Height="22" Margin="0,0,8,0" />
                    <TextBlock Text="WindowFix" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <RadioButton x:Name="SettingsNav" DockPanel.Dock="Bottom" GroupName="Nav" Style="{StaticResource NavItem}" Checked="OnSettingsNav">
                    <TextBlock Text="⚙  설정" />
                </RadioButton>
                <Button DockPanel.Dock="Top" Content="+ 새 배치 생성" Click="OnSaveCurrent" Style="{StaticResource Primary}"
                        Margin="0,0,0,14" HorizontalAlignment="Stretch"
                        ToolTip="지금 화면에 놓인 창들의 위치와 크기를 새 배치로 저장해요." />
                <TextBlock DockPanel.Dock="Top" Text="저장한 배치" Style="{StaticResource Hint}" Margin="8,0,0,6" />
                <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource LayoutItem}" SelectionChanged="OnPresetSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <DockPanel Grid.Column="1">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="22,0,22,12" TextWrapping="Wrap" MaxHeight="80"
                       Foreground="{DynamicResource Fg.Secondary}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <Grid>
                <!-- Layout page -->
                <DockPanel x:Name="LayoutPage" Margin="22,18,22,10">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="이 배치로 맞추기" Click="OnApply" Margin="0"
                                ToolTip="고른 배치대로 창들을 지금 바로 옮겨요." />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PresetTitle" Text="배치 없음" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border x:Name="StatusChip" CornerRadius="10" Padding="9,3" Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusChipText" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="AdminBanner" DockPanel.Dock="Top" CornerRadius="10" BorderThickness="1" Padding="14,10" Margin="0,0,0,12"
                            Background="{DynamicResource Lock.Paused.Bg}" BorderBrush="{DynamicResource Lock.Paused.Border}" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="관리자 권한으로 다시 실행" Click="OnRestartElevated" Style="{StaticResource Primary}" Margin="0" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="⚠ 관리자 권한 앱이 있어요" FontWeight="SemiBold" Foreground="{DynamicResource Lock.Paused.Fg}" />
                                <TextBlock x:Name="AdminBannerText" Style="{StaticResource Hint}" Foreground="{DynamicResource Fg.Secondary}"
                                           Text="일부 게임처럼 관리자 권한으로 켜진 창은 WindowFix도 관리자 권한이어야 옮길 수 있어요." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border x:Name="LockCard" DockPanel.Dock="Top" CornerRadius="10" BorderThickness="1" Padding="16,12" Margin="0,0,0,14">
                        <CheckBox x:Name="LockCheck" Click="OnLockClick" VerticalAlignment="Center" Margin="0"
                                  ToolTip="켜 두면, 창을 실수로 움직이거나 크기를 바꿔도 저장한 자리로 바로 돌아가요.">
                            <StackPanel>
                                <TextBlock x:Name="LockLabel" Text="🔒 창 고정" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LockHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock x:Name="AppsLabel" Text="이 배치의 창 — 누르면 그 창 설정을 열어요" Style="{StaticResource Hint}" Margin="2,0,0,6" />
                            <ItemsControl x:Name="AppList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnAppChipClick" Tag="{Binding Id}" Margin="0,0,8,8" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Text="  ⚙" Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Background="{DynamicResource Bg.Stage}" CornerRadius="10">
                            <Grid>
                                <c:MonitorPreview x:Name="Preview" Margin="10,10,10,30" />
                                <TextBlock x:Name="PreviewHint" Foreground="{DynamicResource Fg.Muted}" HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom" Margin="0,0,0,9" FontSize="12"
                                           Text="모니터를 누르면 이 배치를 고칠 수 있어요 · 창을 우클릭하면 그 창 설정" />
                                <Border x:Name="Guide" Background="{DynamicResource Guide.Overlay}" CornerRadius="10" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                        <TextBlock Text="처음 오셨나요? 세 단계면 끝나요." FontSize="20" FontWeight="SemiBold"
                                                   Margin="0,0,0,22" HorizontalAlignment="Center" />
                                        <DockPanel Margin="0,0,0,16">
                                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel>
                                                <TextBlock Text="창을 원하는 자리에 놓으세요" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Text="디스코드, 카톡처럼 늘 켜 두는 창을 평소 쓰는 위치와 크기로 맞춰 두세요." />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,16">
                                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel>
                                                <TextBlock Text="[+ 새 배치 생성]을 누르세요" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Text="떠 있는 창 목록이 나오면, 고정할 창에 체크하고 저장하면 돼요." />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,22">
                                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            <StackPanel>
                                                <TextBlock Text="[🔒 창 고정]을 켜세요" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Hint}" FontSize="12.5" Text="이제 창을 실수로 건드려도 제자리로 돌아와요. 컴퓨터를 껐다 켜도 유지돼요." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Button Content="+ 새 배치 생성" Click="OnSaveCurrent" Style="{StaticResource Primary}"
                                                HorizontalAlignment="Center" Padding="22,9" FontSize="14" Margin="0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        </DockPanel>

                        <Border x:Name="EditPanel" Grid.Column="1" Width="280" Margin="14,0,0,0" Style="{StaticResource Card}" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="✕" Click="OnEditClose" Margin="0" Padding="7,1"
                                                BorderThickness="0" Background="Transparent" ToolTip="닫기" />
                                        <TextBlock x:Name="EditTitle" Text="창 설정" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="이름" Style="{StaticResource Label}" />
                                    <TextBox x:Name="NameBox" Margin="0,4,0,12" />
                                    <CheckBox x:Name="LaunchCheck" ToolTip="배치를 맞출 때 이 프로그램이 꺼져 있으면 켜 주고, 트레이에 숨어 있으면 꺼내서 제자리에 놓아요.">
                                        <TextBlock Text="꺼져 있으면 자동으로 켜기 (숨어 있으면 꺼내기)" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox x:Name="MaxCheck" Content="최대화 상태로 두기" ToolTip="이 창을 모니터를 꽉 채운 상태로 고정해요." />

                                    <Expander Header="위치와 크기 직접 고치기" Margin="0,12,0,0" Foreground="{DynamicResource Fg.Secondary}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource Hint}" Text="보통은 손대지 않아도 돼요. 창을 원하는 자리에 놓고 새 배치를 만드는 게 더 쉬워요. 숫자는 모니터 왼쪽 위 모서리에서부터의 픽셀이에요." />
                                            <UniformGrid Columns="4" Margin="0,6,0,0">
                                                <TextBlock Text="가로" Style="{StaticResource Hint}" />
                                                <TextBlock Text="세로" Style="{StaticResource Hint}" />
                                                <TextBlock Text="너비" Style="{StaticResource Hint}" />
                                                <TextBlock Text="높이" Style="{StaticResource Hint}" />
                                            </UniformGrid>
                                            <UniformGrid Columns="4" Margin="0,3,0,0">
                                                <TextBox x:Name="XBox" Margin="0,0,4,0" />
                                                <TextBox x:Name="YBox" Margin="0,0,4,0" />
                                                <TextBox x:Name="WBox" Margin="0,0,4,0" />
                                                <TextBox x:Name="HBox" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="고급 설정" Margin="0,8,0,0" Foreground="{DynamicResource Fg.Secondary}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="같은 프로그램 창이 여러 개일 때" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Text="제목에 이 글자가 들어간 창만 고정해요. 예: 크롬 창 중 'YouTube'만" />
                                            <DockPanel Margin="0,4,0,12">
                                                <Button DockPanel.Dock="Right" Content="지금 창 제목 가져오기" Click="OnPickTitle" Margin="6,0,0,0" Padding="8,4"
                                                        ToolTip="지금 떠 있는 이 프로그램의 창 제목을 채워 넣어요. 필요 없는 부분은 지우세요." />
                                                <TextBox x:Name="TitleBox" />
                                            </DockPanel>

                                            <TextBlock Text="자동으로 켤 때 실행할 파일" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Text="'꺼져 있으면 자동으로 켜기'를 쓸 때만 필요해요. 보통은 저장할 때 알아서 채워져요." />
                                            <DockPanel Margin="0,4,0,8">
                                                <Button DockPanel.Dock="Right" Content="찾아보기…" Click="OnBrowseExe" Margin="6,0,0,0" Padding="8,4" />
                                                <TextBox x:Name="PathBox" />
                                            </DockPanel>
                                            <TextBlock Text="실행 옵션 (선택)" Style="{StaticResource Hint}" />
                                            <TextBox x:Name="ArgsBox" Margin="0,4,0,10" ToolTip="예: 디스코드는 --processStart Discord.exe" />
                                            <TextBlock x:Name="MatchInfo" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Expander>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="저장" Click="OnEntrySave" Style="{StaticResource Primary}" />
                                        <Button Content="이 창 빼기" Click="OnEntryRemove" ToolTip="이 창을 배치에서 빼요. 프로그램이 꺼지지는 않아요." />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- Settings page -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18,22,10" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="설정" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="화면 테마" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Hint}" Text="'시스템 설정 따라가기'는 Windows의 밝게/어둡게 설정을 그대로 따라가요." Margin="0,2,0,10" />
                                <Border Background="{DynamicResource Bg.Stage}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Segment}" Content="시스템 설정 따라가기" Click="OnThemeClick" />
                                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Segment}" Content="☀ 라이트" Click="OnThemeClick" />
                                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Segment}" Content="☾ 다크" Click="OnThemeClick" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="StartupCheck" Click="OnStartupClick" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="컴퓨터 켤 때 배치 맞추기" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="컴퓨터를 켜면 창들이 늦게 떠도 기다렸다가 제자리에 놓아 줘요." />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="StartupPickLabel" Text="어떤 배치로 맞출까요?" Style="{StaticResource Hint}" Margin="46,10,0,4" />
                                <Border x:Name="StartupPickBox" Background="{DynamicResource Bg.Stage}" CornerRadius="8" Padding="2" Margin="46,0,0,0" HorizontalAlignment="Left">
                                    <ItemsControl x:Name="StartupPresetList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="StartupPreset" Style="{StaticResource Segment}" Content="{Binding Name}"
                                                             Tag="{Binding Id}" Click="OnStartupPresetClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="AdminCheck" Click="OnAdminClick" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="항상 관리자 권한으로 실행" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="메이플처럼 관리자 권한으로 켜지는 게임 창도 고정하려면 켜세요. 컴퓨터를 켤 때도 관리자 권한으로 자동 실행돼요. 처음 켤 때 한 번만 확인 창이 떠요." />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="AdminState" Style="{StaticResource Hint}" Margin="46,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ButtonCheck" Click="OnButtonClick" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="화면 가장자리에 고정 탭 띄우기" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="창 고정 중일 때 모니터 가장자리에 작은 탭이 붙어요. 누르면 잠깐 풀고, 다시 누르면 원래 자리로 돌아가요." />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="TrayCheck" Click="OnTrayClick" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="작업표시줄에 아이콘 표시" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Text="시계 옆에 WindowFix 아이콘을 보여 줘요. 숨겨도 WindowFix를 다시 실행하면 이 창이 열려요." />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
