<Window x:Class="WindowFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WindowFix.Controls"
        Title="WindowFix" Width="980" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8EAEE" Padding="12,5">
            <TextBlock x:Name="StatusText" Foreground="#444" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Settings toggles -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE0E5" BorderThickness="0,1,0,0" Padding="14,8">
            <WrapPanel>
                <CheckBox x:Name="LockCheck" Content="🔒 잠금" Margin="0,3,24,3" FontWeight="SemiBold"
                          Click="OnLockClick" />
                <CheckBox x:Name="TrayCheck" Content="트레이 아이콘 표시" Margin="0,3,24,3" Click="OnTrayClick" />
                <CheckBox x:Name="ButtonCheck" Content="고정 버튼 표시" Margin="0,3,24,3" Click="OnButtonClick" />
                <CheckBox x:Name="StartupCheck" Content="윈도우 시작 시 이 프리셋 적용" Margin="0,3,24,3" Click="OnStartupClick" />
            </WrapPanel>
        </Border>

        <!-- Preset bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDE0E5" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="프리셋" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#555" />
                <ComboBox x:Name="PresetCombo" Width="220" Margin="0,0,8,0" DisplayMemberPath="Name"
                          SelectionChanged="OnPresetSelected" />
                <Button x:Name="ApplyButton" Content="적용" Click="OnApply" FontWeight="SemiBold" />
                <Button Content="+ 지금 배치 저장" Click="OnSaveCurrent" />
                <Button x:Name="RenameButton" Content="이름 변경" Click="OnRename" />
                <Button x:Name="DeleteButton" Content="삭제" Click="OnDelete" />
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="#16181C" CornerRadius="6">
                <Grid>
                    <c:MonitorPreview x:Name="Preview" Margin="8" />
                    <TextBlock x:Name="EmptyHint" Foreground="#9AA0AA" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,14" Text="창을 원하는 자리에 놓고 [+ 지금 배치 저장]을 눌러 프리셋을 만드세요." />
                </Grid>
            </Border>

            <!-- Edit panel: visible when a window rectangle is selected -->
            <Border x:Name="EditPanel" Grid.Column="1" Width="270" Margin="12,0,0,0" Background="White" CornerRadius="6"
                    BorderBrush="#DDE0E5" BorderThickness="1" Padding="12" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="창 설정" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <TextBlock Text="표시 이름" Foreground="#666" />
                        <TextBox x:Name="NameBox" Margin="0,2,0,8" />
                        <TextBlock Text="위치와 크기 (모니터 기준, 픽셀)" Foreground="#666" />
                        <UniformGrid Columns="4" Margin="0,2,0,2">
                            <TextBlock Text="X" Foreground="#888" />
                            <TextBlock Text="Y" Foreground="#888" />
                            <TextBlock Text="너비" Foreground="#888" />
                            <TextBlock Text="높이" Foreground="#888" />
                        </UniformGrid>
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <TextBox x:Name="XBox" Margin="0,0,3,0" />
                            <TextBox x:Name="YBox" Margin="0,0,3,0" />
                            <TextBox x:Name="WBox" Margin="0,0,3,0" />
                            <TextBox x:Name="HBox" />
                        </UniformGrid>
                        <CheckBox x:Name="MaxCheck" Content="최대화 상태로 두기" />
                        <TextBlock Text="제목 조건 (이 글자가 제목에 있는 창만)" Foreground="#666" Margin="0,8,0,0" />
                        <TextBox x:Name="TitleBox" Margin="0,2,0,8" />
                        <CheckBox x:Name="LaunchCheck" Content="없으면 실행, 숨어 있으면 꺼내기" />
                        <TextBlock Text="실행 경로" Foreground="#666" Margin="0,8,0,0" />
                        <TextBox x:Name="PathBox" Margin="0,2,0,6" />
                        <TextBlock Text="실행 인자" Foreground="#666" />
                        <TextBox x:Name="ArgsBox" Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="변경 저장" Click="OnEntrySave" FontWeight="SemiBold" />
                            <Button Content="이 창 빼기" Click="OnEntryRemove" />
                        </StackPanel>
                        <TextBlock x:Name="MatchInfo" Foreground="#999" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
