<Window x:Class="WindowFix.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowFix" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Fg.Primary}">
    <Border x:Name="Card" Margin="16" CornerRadius="12" Background="{DynamicResource Bg.Card}"
            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.3" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="0.94" ScaleY="0.94" />
        </Border.RenderTransform>
        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Secondary}" LineHeight="20" />
            <TextBox x:Name="InputBox" Margin="0,12,0,0" Visibility="Collapsed" FontSize="14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="취소" IsCancel="True" Click="OnCancel" Padding="16,7" />
                <Button x:Name="OkButton" Content="확인" IsDefault="True" Click="OnOk" Style="{StaticResource Primary}" Padding="16,7" Margin="0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
